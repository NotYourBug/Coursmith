# Copy this file to .env for local development. Never commit the real values.
DEEPSEEK_API_KEY=
COURSE_BASE_URL=https://api.deepseek.com/
COURSE_CONTENT_ROOT=content/courses
COURSE_DATABASE=data/course.db
COURSE_SESSION_TTL_HOURS=72
COURSE_ENVIRONMENT=development
# Public course-site Origin; separate from COURSE_BASE_URL (the LLM endpoint).
# Production requires an explicit https:// origin without a trailing slash.
COURSE_SITE_ORIGIN=http://127.0.0.1:8000
# Comma-separated CIDRs. Empty means all forwarded headers are ignored.
# Trusted proxies must append X-Forwarded-For; preserve the ASGI socket peer.
COURSE_TRUSTED_PROXY_CIDRS=
# Admin M1 operator handoff: docs/operations/admin-v1-runbook.md.
# Both CLI serve and direct factory startup must preserve the socket peer:
# python -m uvicorn course_platform.app:create_app --factory --no-proxy-headers
# Existing DB upgrades are offline, explicit, backed up, and target latest5.
# Back up the DB together with matching immutable content; verify copied paths.
# Browser acceptance: COURSMITH_BROWSER_CHANNEL=chrome selects installed Chrome;
# unset it for bundled Chromium. Missing browsers are failures, never skips.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
