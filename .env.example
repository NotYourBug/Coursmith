# Copy this file to .env for local development. Never commit the real values.
DEEPSEEK_API_KEY=
COURSE_BASE_URL=https://api.deepseek.com/
COURSE_CONTENT_ROOT=content/courses
COURSE_DATABASE=data/course.db
COURSE_SESSION_TTL_HOURS=72
COURSE_ENVIRONMENT=development
# Public course-site Origin; separate from COURSE_BASE_URL (the LLM endpoint).
# Production requires an explicit https:// origin without a trailing slash.
COURSE_SITE_ORIGIN=http://127.0.0.1:8000
# Comma-separated CIDRs. Empty means all forwarded headers are ignored.
# Trusted proxies must append X-Forwarded-For; preserve the ASGI socket peer.
COURSE_TRUSTED_PROXY_CIDRS=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
